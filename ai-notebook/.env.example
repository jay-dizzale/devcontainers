# Notebook scripts folder — generated by setup.sh (or edit directly, then
# `docker compose up -d --force-recreate` in ai-notebook/ to pick it up).
#
# Optional: leave commented out to skip (mounts the empty ./notebooks-default/
# instead). If set, this host directory is bind-mounted read-write at
# ~/notebooks inside the container, alongside /workspace.
# NOTEBOOKS_PATH=/Users/you/repos/ai-notebooks
