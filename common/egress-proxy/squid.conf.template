# squid.conf — generated by setup.sh from squid.conf.template.
# Do not edit common/egress-proxy/squid.conf directly; it's regenerated
# every time setup.sh runs (and lost on the next run if you do).

http_port 3128

# __CACHE_PEER__

# CONNECT (HTTPS tunneling) is only ever allowed to port 443 — this is
# checked purely from the CONNECT request line ("CONNECT host:443"), no TLS
# termination/inspection needed, so TLS stays end-to-end encrypted.
acl SSL_ports port 443
acl CONNECT method CONNECT

acl allowed_sites dstdomain "/etc/squid/allowlist.txt"

http_access deny CONNECT !SSL_ports
http_access allow allowed_sites
http_access deny all

access_log /var/log/squid/access.log squid
