HISTFILE=/home/ubuntu/.history/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
unsetopt HIST_SAVE_BY_COPY

autoload -Uz vcs_info
precmd() { vcs_info }

zstyle ':vcs_info:git:*' formats '%b '

setopt PROMPT_SUBST
alias ll='ls -lah'

## CUSTOM FUNCTIONS
function gitpush() {
  git add .
  git commit -m "${1}"
  git push origin
}

if [ -f $HOME/.zshrc2 ]; then
  echo "{zshenv} Setting RC2 up with ZSH."
  source "$HOME/.zshrc2"
fi
PROMPT='%F{green}%*%f %F{blue}%~%f %F{red}${vcs_info_msg_0_}%f$ '

# infrastructure-toolbelt only: show the active AWS_PROFILE/AWS_REGION on the
# prompt line, since a wrong profile/region is exactly the kind of mistake
# that's expensive to make against real infra. Gated on DEVCONTAINER_TYPE
# (set per-env in each Dockerfile), not on AWS_PROFILE/AWS_REGION being set,
# so other toolbelts never show this segment; PROMPT_SUBST (set above)
# re-evaluates the ${...:-none} fallbacks on every prompt draw, so switching
# profile/region mid-session is reflected immediately.
if [ "${DEVCONTAINER_TYPE:-}" = "infrastructure-toolbelt" ]; then
  PROMPT='%F{green}%*%f %F{blue}%~%f %F{yellow}${AWS_PROFILE:-none}:${AWS_REGION:-none}%f %F{red}${vcs_info_msg_0_}%f$ '
fi

  git config --global user.email "CHANGE_ME@example.com"
  git config --global user.name "Change Me"

# Set Global Editor
git config --global init.defaultBranch main
git config --global core.editor vim
git config --global color.branch auto
git config --global color.diff auto
git config --global color.interactive auto
git config --global color.status auto
git config --global color.grep auto
git config --global --replace-all safe.directory '*'
git config --global --bool push.autoSetupRemote true
git config --global pull.rebase false

# Wire up gh's credential helper so `git push`/`git clone` over HTTPS work
# without a separate login - only if gh is installed and has a stored token.
# `gh auth token` reads the mounted config offline; `gh auth status` would call
# the GitHub API through the egress proxy on every login and can hang the shell
# before the prompt (and motd) appear.
if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1; then
  gh auth setup-git >/dev/null 2>&1
fi

# Same idea for tea (Gitea CLI) - only if tea is installed and has a config.
# Checked offline for the same reason (`tea whoami` is a network call); -f
# because Docker mounts a missing host file as an empty directory.
if command -v tea >/dev/null 2>&1 && [ -f "$HOME/.config/tea/config.yml" ] && [ -s "$HOME/.config/tea/config.yml" ]; then
  tea login helper setup >/dev/null 2>&1
fi

# AWS CLI ignores the system CA trust store by default - if install-common.sh
# baked a custom CA (SSL-inspecting proxy) into it, point AWS CLI at the
# combined bundle so it trusts that cert too. Only if a custom cert was
# actually installed and the AWS CLI is present.
if command -v aws >/dev/null 2>&1 && [ -n "$(print -rl -- /usr/local/share/ca-certificates/*.crt(N))" ]; then
  export AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
fi

export PATH="$HOME/.local/bin:$PATH"

# uv (Python version/venv manager) is installed on every image - copy instead
# of hardlinking so caches on a different filesystem (e.g. a bind-mounted
# /workspace) don't break.
export UV_LINK_MODE=copy

[ -t 1 ] && motd
