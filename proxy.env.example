# Proxy configuration for devcontainers.
# Copy this file to proxy.env and fill in your values.
# proxy.env is gitignored — never commit it.
#
# Both upper and lower case variants are set because tools differ:
#   - curl, wget, apt use lowercase
#   - Some Go/Java tools use uppercase
#
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.corp.example.com
#
# http_proxy=http://proxy.example.com:8080
# https_proxy=http://proxy.example.com:8080
# no_proxy=localhost,127.0.0.1,.corp.example.com
